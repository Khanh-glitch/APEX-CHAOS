+  function syncQuestRailSlots(teams) {
+    const quest=Array.isArray(teams) && teams.length===2;
+    if(R.hud)R.hud.dataset.quest=quest?'1':'0';
+    for(let i=0;i<2;i++){
+      const clip=R.rail[i]?.bar?.querySelector('.vr-clip');
+      if(!clip)continue;
+      let lane=clip.querySelector('.vr-quest-slots');
+      if(!quest||!Array.isArray(teams[i])||!teams[i].length){
+        if(lane)lane.remove();
+        continue;
+      }
+      const actors=teams[i];
+      // The Gold template prints /1000 statically; its original renderRail
+      // only updates the numerator. Quest must show the REAL sum of max HP.
+      const maxLabel=R.rail[i].root.querySelector('.vr-max');
+      const teamMax=actors.reduce((n,f)=>n+Math.max(0,Number(f.maxHp)||0),0);
+      const maxCopy='/'+Math.round(teamMax);
+      if(maxLabel&&maxLabel.textContent!==maxCopy)maxLabel.textContent=maxCopy;
+      if(!lane){
+        lane=document.createElement('div');
+        lane.className='vr-quest-slots';
+        clip.appendChild(lane);
+      }
+      if(lane.children.length!==actors.length){
+        lane.replaceChildren(...actors.map(()=>{
+          const segment=document.createElement('span');
+          segment.appendChild(document.createElement('i'));
+          return segment;
+        }));
+      }
+      actors.forEach((actor,k)=>{
+        const slot=lane.children[k];
+        const max=Math.max(1,Number(actor.maxHp)||1);
+        const ratio=Math.max(0,Math.min(1,(Number(actor.hp)||0)/max));
+        const ident=String(actor.id||'');
+        if(slot.dataset.actor!==ident)slot.dataset.actor=ident;
+        const value=ratio.toFixed(4);
+        if(slot.style.getPropertyValue('--qhp')!==value)slot.style.setProperty('--qhp',value);
+        slot.title=ident+' '+Math.round(Number(actor.hp)||0)+'/'+Math.round(max);
+      });
+    }
+    if(quest)renderTimer(); // Gold demo timer must not survive the first real Quest frame
+  }
