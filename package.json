{
  "name": "apex-chaos-vite-refactor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "dev": "pnpm arsenal:sfx:materialize && vite --host 127.0.0.1 --port 5173",
    "dev:lan": "pnpm arsenal:sfx:materialize && vite --host 0.0.0.0 --port 5173",
    "room-server": "node server/manual-room-relay.js",
    "test:multiplayer": "node tools/testRealtimeMultiplayer.mjs",
    "test:arsenal": "pnpm arsenal:sfx:materialize && node tools/testArsenalQuestRuntime.mjs",
    "test:arsenal:headless": "pnpm arsenal:sfx:materialize && node tools/testArsenalQuestHeadless.mjs",
    "build": "pnpm arsenal:sfx:materialize && node tools/generatePublicAssetManifest.cjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "arsenal:sfx:materialize": "node tools/materializeArsenalFinalSfx.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.9",
    "@resvg/resvg-js": "2.6.2",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "30.1.1",
    "vite": "^5.4.0"
  }
}
